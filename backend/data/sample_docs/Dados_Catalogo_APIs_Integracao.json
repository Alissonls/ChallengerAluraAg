        "Excel",
        "PowerPoint",
        "Markdown",
        "CSV",
        "JSON",
        "HTML"
      ],
      "autenticacao": "Bearer OAuth2 / OCI IAM Token"
    },
    {
      "nome": "API de RAG & Consulta de Agente",
      "path": "/api/v1/chat/query",
      "metodo": "POST",
      "payload_exemplo": {
        "query": "Qual a política de reembolso de viagens?",
        "domain": "Financeiro e Contábil"
      },
      "tempo_resposta_esperado": "< 500ms"
    }
  ]
}